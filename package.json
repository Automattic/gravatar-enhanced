{
	"name": "gravatar-enhanced",
	"version": "0.13.1",
	"description": "Gravatar Enhanced WordPress plugin",
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build && ./dev/lintfix.sh",
		"release": "yarn build && rm -rf release && mkdir -p release && cp -R build *.php readme.txt changelog.txt release && mkdir release/classes && tar -C classes --exclude='*.scss' -cf - . | tar -C release/classes -xf -",
		"release:sync": "yarn release && rsync -az --progress --delete release/ $npm_config_gravatar_enhanced",
		"dist": "yarn release && rm -rf dist && mkdir dist && mv release gravatar-enhanced && zip gravatar-enhanced.zip -r gravatar-enhanced && mv gravatar-enhanced release && mv gravatar-enhanced.zip dist",
		"dist:github": "yarn dist && release-it",
		"dist:svn": "yarn dist && ./dev/svn.sh $npm_package_version",
		"blueprint": "BASE64=`base64 --input assets/blueprints/blueprint.json` && echo \"https://playground.wordpress.net/#$BASE64\"",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"test:unit:js": "wp-scripts test-unit-js --runInBand",
		"update": "ncu -u"
	},
	"author": "Automattic",
	"license": "GPL-2.0-only",
	"release-it": {
		"github": {
			"release": true,
			"autoGenerate": true,
			"preRelease": true,
			"assets": [
				"dist/gravatar-enhanced.zip"
			]
		},
		"npm": false
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/scripts": "^36.1.0",
		"eslint": "^10.0.0",
		"globals": "^16.0.0",
		"npm-check-updates": "^23.1.1",
		"prettier": "npm:wp-prettier@^3.9.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"release-it": "^21.1.1",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"@gravatar-com/hovercards": "^0.16.0",
		"@gravatar-com/quick-editor": "^0.8.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/escape-html": "^3.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/url": "^4.57.0",
		"clsx": "^2.1.1",
		"js-sha256": "^1.0.0",
		"lodash.debounce": "^4.0.8"
	},
	"packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
